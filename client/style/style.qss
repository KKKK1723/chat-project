QDialog#ChatDialog QLineEdit#search_edit {
    background: #efefef;
    border: none;
    border-radius: 8px;

    color: #666;
}
QDialog#ChatDialog QLineEdit#search_edit::placeholder { color: #b9b9b9; }
QDialog#ChatDialog QLineEdit#search_edit:focus { background: #eaeaea; }
/* ChatDialog 加号按钮 */
QDialog#ChatDialog QPushButton#add_btn {
    min-width: 28px; min-height: 28px;
    max-width: 28px; max-height: 28px;
    background: #efefef;
    border: none;
    border-radius: 8px;
    color: #c2c2c2;
    font-weight: 600;
    font-size: 18px;
}
QDialog#ChatDialog QPushButton#add_btn:hover { background: #e9e9e9; }
QDialog#ChatDialog QPushButton#add_btn:pressed { background: #e0e0e0; }




